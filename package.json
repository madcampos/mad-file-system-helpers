{
	"name": "@mad-c/file-system-helpers",
	"version": "2.0.0",
	"description": "Helper for working with the File System API",
	"keywords": [
		"file system",
		"FS",
		"browser file system",
		"origin private file system",
		"OPFS"
	],
	"author": {
		"name": "madcampos",
		"url": "https://madcampos.dev/"
	},
	"license": "LGPL-2.1-or-later",
	"homepage": "https://github.com/madcampos/mad-file-system-helpers#readme",
	"bugs": {
		"url": "https://github.com/madcampos/mad-file-system-helpers/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/madcampos/mad-file-system-helpers.git"
	},
	"funding": [
		{
			"type": "Buy Me a Coffee",
			"url": "https://buymeacoffee.com/madcampos"
		},
		{
			"type": "Ko-Fi",
			"url": "https://ko-fi.com/madcampos"
		}
	],
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/opfs.js",
		"./path": "./dist/path.js",
		"./permissions": "./dist/permissions.js",
		"./access": "./dist/fs-access.js"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint:js": "oxlint --fix",
		"lint": "npm run typecheck && npm run lint:js",
		"format": "dprint fmt",
		"version": "npm version --sign-git-tag --message \"chore: update package version\"",
		"postversion": "changelog --output \"docs/changelog\" --push --create-release",
		"update": "update",
		"browsers": "playwright install chromium",
		"test": "vitest",
		"build": "tsc --project tsconfig.build.json",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@mad-c/config": "^3.1.0",
		"@types/node": "^26.1.1",
		"@types/wicg-file-system-access": "^2023.10.7",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"dprint": "^0.55.2",
		"oxlint": "^1.74.0",
		"oxlint-tsgolint": "^0.25.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
